{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/question-type-graph/format-adapter.schema.json",
  "title": "Question Type Graph format adapter",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reviewer_confirmed",
    "profile",
    "hierarchy",
    "content"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["review_required", "passed"]},
    "reviewer_confirmed": {"type": "boolean"},
    "profile": {"type": "string", "minLength": 1},
    "output_policy": {
      "type": "object",
      "properties": {
        "generate_index": {"type": "boolean"},
        "generate_canvas": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "filename_policy": {
      "type": "object",
      "required": ["colon_replacement"],
      "properties": {
        "colon_replacement": {"const": "_"}
      },
      "additionalProperties": true
    },
    "inventory": {
      "type": "object",
      "properties": {
        "role_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "pattern"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "hierarchy": {
      "type": "object",
      "required": ["source_role", "root_output", "entries"],
      "properties": {
        "source_role": {"type": "string", "minLength": 1},
        "root_output": {"type": "string", "pattern": "\\.md$"},
        "primary_authority": {"type": "object"},
        "no_toc_authority": {"type": "object"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "title": {"type": "string"},
              "level": {"type": "integer", "minimum": 1, "maximum": 6},
              "output": {"type": "string"},
              "match_pattern": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "oneOf": [
        {"required": ["primary_authority"], "not": {"required": ["no_toc_authority"]}},
        {"required": ["no_toc_authority"], "not": {"required": ["primary_authority"]}}
      ],
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "required": ["question_patterns", "roles"],
      "properties": {
        "unknown_label_policy": {"enum": ["review", "retain"]},
        "question_patterns": {"$ref": "#/$defs/number_patterns"},
        "inline_question_patterns": {"$ref": "#/$defs/optional_number_patterns"},
        "question_kind_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "pattern"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1},
              "answer_handling": {"enum": ["external", "separate-authoritative"]},
              "solution_layout": {"enum": ["tail", "interleaved"]},
              "solution_start_patterns": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "solution_resume_patterns": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "authoritative_callout_title": {"type": "string", "minLength": 1},
              "answer_shape": {"enum": ["auto", "composite"]},
              "atomize_interleaved_subquestions": {"type": "boolean"},
              "atomized_subquestion_patterns": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "atomized_number_template": {"type": "string", "minLength": 1},
              "sequence_policy": {"enum": ["none", "continuous"]},
              "preserve_internal_headings": {"type": "boolean"},
              "folder": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "question_count_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "kind", "count", "evidence", "reviewer_confirmed"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 0},
              "evidence": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "reviewed_semantic_line_exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "raw_line", "source_page", "reason", "reviewer_confirmed"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "raw_line": {"type": "integer", "minimum": 1},
              "source_page": {"type": "integer", "minimum": 1},
              "source_bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [
              {"required": ["anchor_text"]},
              {"required": ["anchor_pattern"]}
            ],
            "additionalProperties": false
          }
        },
        "reviewed_semantic_line_splits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "raw_line", "raw_columns", "source_page", "reason", "reviewer_confirmed"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "raw_line": {"type": "integer", "minimum": 1},
              "raw_columns": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 2}
              },
              "source_page": {"type": "integer", "minimum": 1},
              "source_bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [
              {"required": ["anchor_text"]},
              {"required": ["anchor_pattern"]}
            ],
            "additionalProperties": false
          }
        },
        "worked_example_solution_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "worked_example_solution_backtrack_fence": {"type": "boolean"},
        "worked_example_callout_title": {"type": "string", "minLength": 1},
        "answer_callout_layout_version": {"const": 2},
        "note_properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "pattern"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "allow_multiple": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "question_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "contexts": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "kinds": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1}
            },
            "anyOf": [
              {"required": ["context"]},
              {"required": ["contexts"]},
              {"required": ["roles"]},
              {"required": ["kinds"]},
              {"required": ["start_line"]},
              {"required": ["end_line"]}
            ],
            "additionalProperties": false
          }
        },
        "question_number_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "start_line"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "start_line": {"type": "integer", "minimum": 1},
              "raw_column": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "question_number_shift_ranges": {
          "$ref": "#/$defs/reviewed_number_shift_ranges"
        },
        "recovered_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "body", "after_line", "source_page", "reviewer_confirmed"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "body": {"type": "string", "minLength": 1},
              "after_line": {"type": "integer", "minimum": 1},
              "source_page": {"type": ["string", "integer"]},
              "source_bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "recovered_question_fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "context",
              "raw_line",
              "raw_column",
              "position",
              "text",
              "source_page",
              "reviewer_confirmed"
            ],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "raw_line": {"type": "integer", "minimum": 1},
              "raw_column": {"type": "integer", "minimum": 1},
              "position": {"enum": ["before", "after"]},
              "text": {"type": "string", "minLength": 1},
              "source_page": {"type": ["string", "integer"]},
              "source_bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [
              {"required": ["anchor_text"]},
              {"required": ["anchor_pattern"]}
            ],
            "additionalProperties": true
          }
        },
        "virtual_span_relocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "context",
              "start_line",
              "end_before_line",
              "before_line",
              "reviewer_confirmed"
            ],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "start_column": {"type": "integer", "minimum": 1},
              "end_before_line": {"type": "integer", "minimum": 1},
              "end_before_column": {"type": "integer", "minimum": 1},
              "before_line": {"type": "integer", "minimum": 1},
              "before_column": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "end_anchor_text": {"type": "string", "minLength": 1},
              "end_anchor_pattern": {"type": "string", "minLength": 1},
              "before_anchor_text": {"type": "string", "minLength": 1},
              "before_anchor_pattern": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "depth", "pattern"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "depth": {"type": "integer", "minimum": 0},
              "pattern": {"type": "string", "minLength": 1},
              "heading_only": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "answers": {
      "type": "object",
      "properties": {
        "source_role": {"type": "string", "minLength": 1},
        "answer_patterns": {"$ref": "#/$defs/number_patterns"},
        "inline_answer_patterns": {"$ref": "#/$defs/optional_number_patterns"},
        "answer_number_shift_ranges": {
          "$ref": "#/$defs/reviewed_number_shift_ranges"
        },
        "recovered_answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "body", "after_line", "source_page", "reviewer_confirmed"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "body": {"type": "string", "minLength": 1},
              "after_line": {"type": "integer", "minimum": 1},
              "source_page": {"type": ["string", "integer"]},
              "source_bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1},
              "reviewer_confirmed": {"const": true}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string"},
              "anchor_pattern": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["pattern"]}, {"required": ["start_line"]}],
            "additionalProperties": true
          }
        },
        "implicit_answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "start_line"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "start_line": {"type": "integer", "minimum": 1},
              "raw_column": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "choice_answer_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "answer", "start_line"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "answer": {"type": "string", "pattern": "^[A-F]+$"},
              "start_line": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        },
        "short_answer_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context", "number", "answer", "start_line"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "number": {"type": ["string", "integer"]},
              "answer": {"type": "string", "minLength": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "anchor_text": {"type": "string", "minLength": 1},
              "anchor_pattern": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "number_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "optional_number_patterns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewed_number_shift_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context", "start_line", "end_line", "offset", "reviewer_confirmed"],
        "properties": {
          "context": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "start_column": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "end_column": {"type": "integer", "minimum": 1},
          "offset": {"type": "integer", "not": {"const": 0}},
          "anchor_text": {"type": "string", "minLength": 1},
          "anchor_pattern": {"type": "string", "minLength": 1},
          "end_anchor_text": {"type": "string", "minLength": 1},
          "end_anchor_pattern": {"type": "string", "minLength": 1},
          "reviewer_confirmed": {"const": true}
        },
        "allOf": [
          {"anyOf": [{"required": ["anchor_text"]}, {"required": ["anchor_pattern"]}]},
          {"anyOf": [{"required": ["end_anchor_text"]}, {"required": ["end_anchor_pattern"]}]}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
