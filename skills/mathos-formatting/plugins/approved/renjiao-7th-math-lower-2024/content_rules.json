{
  "plugin_id": "chapter_inner_markdown_formatter",
  "plugin_version": "2.0.0",
  "schema_version": "1.0.0",
  "stage": "chapter_inner_formatting",
  "description": "针对已完成标题结构整理的人教版七年级下册数学教材 Markdown 章节，修复公式空格、选择题选项粘连、平行符号 OCR 错误、粗体标记、多余空行等章节内部格式问题，严格保护所有标题行。",
  "safety": {
    "never_modify_heading_lines": true,
    "heading_line_pattern": "^\\s*#{1,6}\\s+.*$",
    "never_delete_images": true,
    "never_rewrite_content": true,
    "never_infer_answers": true,
    "never_modify_markdown_tables": true,
    "preserve_code_blocks": true,
    "preserve_html_blocks": true,
    "preserve_math_blocks": true,
    "preserve_yaml_frontmatter": true,
    "forbid_line_index_alignment_restore": true,
    "forbid_heading_to_callout": true,
    "forbid_heading_level_change": true
  },
  "execution_contract": {
    "executor_language": "python",
    "regex_engine": "python_re",
    "allowed_regex_flags": [
      "MULTILINE",
      "DOTALL",
      "IGNORECASE"
    ],
    "default_rule_scope": "non_heading_lines",
    "restore_protected_blocks_order": "reverse",
    "regex_replacement_backslash_policy": "use_lambda_replacement_when_replacement_mode_is_literal",
    "variable_width_lookbehind_allowed": false,
    "dry_run_required_before_write": true,
    "report_required": true
  },
  "protected_blocks": [
    {
      "id": "yaml_frontmatter",
      "name": "保护 YAML frontmatter",
      "type": "block",
      "pattern": "\\A---\\n[\\s\\S]*?\\n---",
      "flags": []
    },
    {
      "id": "fenced_code_block",
      "name": "保护 fenced code block",
      "type": "block",
      "pattern": "```[\\s\\S]*?```",
      "flags": []
    },
    {
      "id": "display_math_dollar",
      "name": "保护行间公式 $$...$$",
      "type": "block",
      "pattern": "\\$\\$[\\s\\S]*?\\$\\$",
      "flags": []
    },
    {
      "id": "display_math_bracket",
      "name": "保护行间公式 \\[...\\]",
      "type": "block",
      "pattern": "\\\\\\[[\\s\\S]*?\\\\\\]",
      "flags": []
    },
    {
      "id": "html_details_block",
      "name": "保护 <details> 折叠块",
      "type": "block",
      "pattern": "<details>[\\s\\S]*?</details>",
      "flags": []
    },
    {
      "id": "markdown_table_block",
      "name": "保护 Markdown 表格",
      "type": "block",
      "pattern": "(?:\\|.*\\|\\n)*\\|[\\s-:]+\\|(?:\\n\\|.*\\|)*",
      "flags": []
    }
  ],
  "analyze": {
    "checks": [
      {
        "id": "count_headings",
        "name": "统计标题行数量",
        "type": "count",
        "pattern": "^\\s*#{1,6}\\s+.*$",
        "flags": [
          "MULTILINE"
        ],
        "message": "文档中标题行数量"
      },
      {
        "id": "count_math",
        "name": "统计公式数量",
        "type": "count",
        "pattern": "\\$\\$[\\s\\S]*?\\$\\$|\\\\\\[[\\s\\S]*?\\\\\\]|\\$[^$]+\\$",
        "flags": [],
        "message": "文档中公式块（行间和行内）数量"
      },
      {
        "id": "count_images",
        "name": "统计图片数量",
        "type": "count",
        "pattern": "!\\[.*?\\]\\(.*?\\)",
        "flags": [],
        "message": "文档中图片数量"
      },
      {
        "id": "count_tables",
        "name": "统计表格数量",
        "type": "count",
        "pattern": "\\|.*\\|",
        "flags": [],
        "message": "文档中表格行数量（近似）"
      },
      {
        "id": "count_callouts",
        "name": "统计 callout 数量",
        "type": "count",
        "pattern": ">\\s*\\[!.*?\\]",
        "flags": [],
        "message": "Obsidian callout 数量"
      },
      {
        "id": "count_code_blocks",
        "name": "统计代码块数量",
        "type": "count",
        "pattern": "```[\\s\\S]*?```",
        "flags": [],
        "message": "文档中代码块数量"
      },
      {
        "id": "detect_abnormal_blank_lines",
        "name": "检测异常空行",
        "type": "report_only",
        "pattern": "\\n{4,}",
        "flags": [],
        "message": "存在连续超过3个空行的区域，建议压缩"
      },
      {
        "id": "detect_image_caption_misalignment",
        "name": "检测疑似图片题注错位",
        "type": "report_only",
        "pattern": "!\\[.*?\\]\\(.*?\\)\\n\\n[^!\\n]",
        "flags": [],
        "message": "发现图片后紧跟空行再跟非图片文本，可能题注错位"
      },
      {
        "id": "detect_heading_like_image_line",
        "name": "检测疑似被误识别为标题的图片行",
        "type": "report_only",
        "pattern": "^\\s*#{1,6}\\s*!\\[.*?\\]\\(.*?\\)",
        "flags": [
          "MULTILINE"
        ],
        "message": "以标题格式开头的图片行，可能为误识别，需人工确认"
      }
    ]
  },
  "rules": [
    {
      "id": "remove_bold_markers",
      "name": "删除粗体标记但保留文字",
      "enabled": true,
      "type": "regex_replace",
      "scope": "non_heading_lines",
      "phase": "pre_clean",
      "risk_level": "low",
      "pattern": "\\*\\*([^\\n*]+?)\\*\\*",
      "replacement": "$1",
      "flags": [],
      "replacement_mode": "regex_template",
      "notes": "清理非标题行中的粗体标记（可能为 OCR 误加或旧格式），保留内部文字。"
    },
    {
      "id": "fix_double_slash_parallel",
      "name": "修复平行符号 OCR 错误 / / -> \\parallel",
      "enabled": true,
      "type": "literal_replace",
      "scope": "all_unprotected_non_heading_text",
      "phase": "formula_fix",
      "risk_level": "low",
      "search": "/ /",
      "replacement": "\\parallel",
      "flags": [],
      "replacement_mode": "literal",
      "notes": "白名单替换，将常见的 OCR 平行符号错误 '/' 空格 '/' 替换为 LaTeX \\parallel。"
    },
    {
      "id": "fix_degree_spacing_in_math",
      "name": "修复公式中数字间的多余空格",
      "enabled": true,
      "type": "regex_replace",
      "scope": "all_unprotected_non_heading_text",
      "phase": "formula_fix",
      "risk_level": "low",
      "pattern": "(\\d)\\s+(\\d)",
      "replacement": "$1$2",
      "flags": [],
      "replacement_mode": "regex_template",
      "notes": "合并数字间的空格，如 '1 8 0' -> '180'，风险较低，可能误伤普通文本中的数字，但教材中极少出现此类情况。"
    },
    {
      "id": "fix_degree_command_spacing",
      "name": "修复角度符号 ^ {\\circ} 的空格 -> ^{\\circ}",
      "enabled": true,
      "type": "literal_replace",
      "scope": "all_unprotected_non_heading_text",
      "phase": "formula_fix",
      "risk_level": "low",
      "search": "^ {\\circ}",
      "replacement": "^{\\circ}",
      "flags": [],
      "replacement_mode": "literal",
      "notes": "白名单替换，将上标与括号间的空格移除。"
    },
    {
      "id": "split_inline_choices_abcd",
      "name": "拆分同一行中的选择题选项 (A)...(B)...(C)...(D)...",
      "enabled": true,
      "type": "regex_replace",
      "scope": "non_heading_lines",
      "phase": "choice_fix",
      "risk_level": "medium",
      "pattern": "\\s+(?=\\([A-D]\\))",
      "replacement": "\\n",
      "flags": [],
      "replacement_mode": "regex_template",
      "notes": "将粘连的选择题选项（如 '(A) ... (B) ...'）拆分为每行一个选项，限定非标题行。"
    },
    {
      "id": "add_blank_line_before_callout",
      "name": "callout 前补空行",
      "enabled": false,
      "type": "callout_spacing_fix",
      "scope": "non_heading_lines",
      "phase": "callout_fix",
      "risk_level": "low",
      "pattern": "([^\\n])\\n(> \\[![A-Za-z0-9_-]+\\])",
      "replacement": "$1\\n\\n$2",
      "flags": [],
      "replacement_mode": "regex_template",
      "notes": "本文档未使用 Obsidian callout，此规则暂禁用。若存在 callout 则启用。"
    },
    {
      "id": "compress_excessive_blank_lines",
      "name": "压缩连续三个及以上空行",
      "enabled": true,
      "type": "blank_line_normalize",
      "scope": "all_unprotected_text",
      "phase": "blank_line_fix",
      "risk_level": "low",
      "pattern": "\\n{3,}",
      "replacement": "\\n\\n",
      "flags": [],
      "replacement_mode": "regex_template",
      "notes": "将连续 3 个及以上的空行压缩为两个空行（即一个空行），保证段落清晰。"
    },
    {
      "id": "post_clean_trailing_whitespace",
      "name": "清理行尾多余空格",
      "enabled": true,
      "type": "regex_replace",
      "scope": "all_unprotected_text",
      "phase": "post_clean",
      "risk_level": "low",
      "pattern": "[ \\t]+$",
      "replacement": "",
      "flags": [
        "MULTILINE"
      ],
      "replacement_mode": "regex_template",
      "notes": "移除每行末尾的空白字符，保持整洁。"
    }
  ],
  "warnings": [
    "1. 所有以 # 开头的标题行已被执行器强制保护，不会受到任何修改。",
    "2. 公式数字空格合并规则 (\\d)\\s+(\\d) 可能误伤非数学内容中相邻数字间的空格，但教材中此类情况罕见，风险较低。",
    "3. 平行符号修复为文字替换 / / -> \\parallel，若存在其他变体（如 '//'）可能无法覆盖，需后续人工检查。",
    "4. 选择题选项拆分遇到含公式或特殊格式的选项行时可能失效，可先用 report_only 检查。",
    "5. 默认禁用了 callout 前补空行规则，因为当前文档未使用 Obsidian callout；如需启用请手动打开。",
    "6. 图片题注错位检测仅提供报告，不会自动修复，需人工介入。"
  ],
  "summary": [
    "生成规则包用于第二阶段章节内部格式修复。",
    "包含 5 个主动修复规则：粗体标记删除、平行符号修复、公式数字空格合并、角度符号空格修复、选择题选项拆分、多余空行压缩、行尾空格清理。",
    "包含 1 个禁用规则（callout 前补空行）。",
    "包含 9 个分析检查规则，用于统计标题、公式、图片、表格、callout、代码块，并检测异常空行和图片题注错位。",
    "所有规则严格保护标题行，仅对非标题内容生效。"
  ]
}